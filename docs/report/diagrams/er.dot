digraph G {
  graph [rankdir=LR, fontname="Helvetica", nodesep=0.35, ranksep=1.0, pad=0.2, splines=true];
  node [shape=plain, fontname="Helvetica", fontsize=9];
  edge [fontname="Helvetica", fontsize=8, color="#555555", arrowtail=crow, arrowhead=tee, dir=both];
  users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>users</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(255)</TD><TD ALIGN="LEFT">UQ</TD></TR><TR><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">varchar(255)</TD><TD ALIGN="LEFT">BCrypt</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(255)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">EMPLOYEE|TECHNICIAN|ADMIN</TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">bool</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">token_version</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  technician_profiles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>technician_profiles</B></TD></TR><TR><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK, FK users</TD></TR><TR><TD ALIGN="LEFT">max_workload</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">experience_years</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">available</TD><TD ALIGN="LEFT">bool</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">is_team_lead</TD><TD ALIGN="LEFT">bool</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">reports_to_user_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK self</TD></TR></TABLE>>];
  technician_skills [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>technician_skills</B></TD></TR><TR><TD ALIGN="LEFT"><B>user_id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK, FK</TD></TR><TR><TD ALIGN="LEFT"><B>category_id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK, FK</TD></TR><TR><TD ALIGN="LEFT">proficiency</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">1..5</TD></TR></TABLE>>];
  incident_categories [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>incident_categories</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">varchar(40)</TD><TD ALIGN="LEFT">UQ</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">bool</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  it_services [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>it_services</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">business_criticality</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">1..5</TD></TR><TR><TD ALIGN="LEFT">owner_team</TD><TD ALIGN="LEFT">varchar(100)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">active</TD><TD ALIGN="LEFT">bool</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  service_dependencies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>service_dependencies</B></TD></TR><TR><TD ALIGN="LEFT"><B>service_id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK, FK</TD></TR><TR><TD ALIGN="LEFT"><B>depends_on_id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK, FK</TD></TR></TABLE>>];
  sla_policies [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>sla_policies</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">service_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK (null = global)</TD></TR><TR><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT">varchar(2)</TD><TD ALIGN="LEFT">P1..P4</TD></TR><TR><TD ALIGN="LEFT">response_minutes</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">resolution_minutes</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">warning_threshold_pct</TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  incidents [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>incidents</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">PK  INC1001+</TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">varchar(200)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">9 states, CHECK</TD></TR><TR><TD ALIGN="LEFT">reporter_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK users</TD></TR><TR><TD ALIGN="LEFT">assignee_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK users</TD></TR><TR><TD ALIGN="LEFT">category_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT">service_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT">varchar(2)</TD><TD ALIGN="LEFT">P1..P4</TD></TR><TR><TD ALIGN="LEFT">impact / urgency</TD><TD ALIGN="LEFT">varchar(10)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">created_at, assigned_at, first_response_at,</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">resolved_at, closed_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">version</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">optimistic lock</TD></TR></TABLE>>];
  incident_sla [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>incident_sla</B></TD></TR><TR><TD ALIGN="LEFT"><B>incident_id</B></TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">PK, FK</TD></TR><TR><TD ALIGN="LEFT">policy_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT">response_due_at / resolution_due_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">response_status / resolution_status</TD><TD ALIGN="LEFT">varchar(10)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(10)</TD><TD ALIGN="LEFT">worst of both</TD></TR><TR><TD ALIGN="LEFT">paused_since, paused_seconds</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  investigation_entries [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>investigation_entries</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">incident_id</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT">author_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK users</TD></TR><TR><TD ALIGN="LEFT">entry_type</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">visibility</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">INTERNAL|REPORTER_VISIBLE</TD></TR><TR><TD ALIGN="LEFT">body</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">incident_state</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  incident_feedback [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>incident_feedback</B></TD></TR><TR><TD ALIGN="LEFT"><B>incident_id</B></TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">PK, FK  (one per incident)</TD></TR><TR><TD ALIGN="LEFT">reporter_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK users</TD></TR><TR><TD ALIGN="LEFT">rating</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT">1..5</TD></TR><TR><TD ALIGN="LEFT">comment</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  incident_escalations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>incident_escalations</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">incident_id</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT">trigger</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">tier</TD><TD ALIGN="LEFT">varchar(20)</TD><TD ALIGN="LEFT">TEAM_LEAD|NEXT_LEVEL|ADMINS</TD></TR><TR><TD ALIGN="LEFT">target_user_ids</TD><TD ALIGN="LEFT">bigint[]</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  notifications [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>notifications</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">recipient_id</TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">FK users</TD></TR><TR><TD ALIGN="LEFT">incident_id</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">FK</TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">priority</TD><TD ALIGN="LEFT">varchar(2)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">channels</TD><TD ALIGN="LEFT">text[]</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">read_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  audit_events [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>audit_events</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK</TD></TR><TR><TD ALIGN="LEFT">occurred_at</TD><TD ALIGN="LEFT">timestamptz</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">actor_type / actor_id / actor_role</TD><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT">varchar(60)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">incident_id</TD><TD ALIGN="LEFT">varchar(30)</TD><TD ALIGN="LEFT">no FK: survives deletes</TD></TR><TR><TD ALIGN="LEFT">previous_state / new_state</TD><TD ALIGN="LEFT">varchar(40)</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"></TD></TR><TR><TD ALIGN="LEFT">metadata</TD><TD ALIGN="LEFT">jsonb</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  assignment_settings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>assignment_settings</B></TD></TR><TR><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">PK (single row)</TD></TR><TR><TD ALIGN="LEFT">active_strategy</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT">LOAD_BASED|SKILL_BASED|ROUND_ROBIN|MANUAL</TD></TR><TR><TD ALIGN="LEFT">default_max_workload</TD><TD ALIGN="LEFT">int</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  assignment_category_overrides [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#dfe8f7"><B>assignment_category_overrides</B></TD></TR><TR><TD ALIGN="LEFT"><B>settings_id</B></TD><TD ALIGN="LEFT">smallint</TD><TD ALIGN="LEFT">PK, FK</TD></TR><TR><TD ALIGN="LEFT"><B>category_id</B></TD><TD ALIGN="LEFT">bigint</TD><TD ALIGN="LEFT">PK, FK</TD></TR><TR><TD ALIGN="LEFT">strategy</TD><TD ALIGN="LEFT">varchar(50)</TD><TD ALIGN="LEFT"></TD></TR></TABLE>>];
  technician_profiles -> users [label="1:0..1"];
  technician_skills -> technician_profiles [label="N:1"];
  technician_skills -> incident_categories [label="N:1"];
  technician_profiles -> technician_profiles [label="reports to"];
  service_dependencies -> it_services [label="N:1 (x2)"];
  sla_policies -> it_services [label="N:0..1"];
  incidents -> users [label="reporter, assignee"];
  incidents -> incident_categories [label="N:1"];
  incidents -> it_services [label="N:1"];
  incident_sla -> incidents [label="1:1"];
  incident_sla -> sla_policies [label="N:0..1"];
  investigation_entries -> incidents [label="N:1"];
  investigation_entries -> users [label="author"];
  incident_feedback -> incidents [label="1:0..1"];
  incident_escalations -> incidents [label="N:1"];
  notifications -> incidents [label="N:0..1"];
  notifications -> users [label="recipient"];
  assignment_category_overrides -> assignment_settings [label="N:1"];
  assignment_category_overrides -> incident_categories [label="N:1"];
}

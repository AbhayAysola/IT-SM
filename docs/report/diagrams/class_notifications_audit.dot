digraph G {
  graph [rankdir=BT, fontname="Helvetica", nodesep=0.45, ranksep=0.65, splines=true, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  NotificationChannel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e6f0ff" ALIGN="CENTER"><I>&laquo;interface&raquo;</I><BR/><B>NotificationChannel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+key: ChannelKey<BR ALIGN="LEFT"/>+transactional: Boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+deliver(notification)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  InAppChannel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>InAppChannel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+deliver(...)  stored, shown by the bell<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SimulatedEmailChannel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>SimulatedEmailChannel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+deliver(...)  P1 and P2 only<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SimulatedSmsChannel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>SimulatedSmsChannel</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+deliver(...)  P1 only<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Notification [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Notification</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+recipientId: Long<BR ALIGN="LEFT"/>+type: NotificationType<BR ALIGN="LEFT"/>+incidentId: String?<BR ALIGN="LEFT"/>+priority: Priority?<BR ALIGN="LEFT"/>+title, body: String<BR ALIGN="LEFT"/>+channels: Set&lt;ChannelKey&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">init { in-app channel is mandatory }<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  NotificationMonitor [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>NotificationMonitor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">@TransactionalEventListener(AFTER_COMMIT)<BR ALIGN="LEFT"/>@Scheduled sweep (safety net)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AuditableEvent [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>AuditableEvent</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+actor: AuditActor<BR ALIGN="LEFT"/>+action: String<BR ALIGN="LEFT"/>+entityType: String<BR ALIGN="LEFT"/>+incidentId: String?<BR ALIGN="LEFT"/>+previousState / newState: String?<BR ALIGN="LEFT"/>+description: String<BR ALIGN="LEFT"/>+metadata: Map<BR ALIGN="LEFT"/>+occurredAt: Instant<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">init { validates action and entityType format }<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AuditPublisher [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e6f0ff" ALIGN="CENTER"><I>&laquo;interface&raquo;</I><BR/><B>AuditPublisher</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+publish(event: AuditableEvent)  (MANDATORY transaction)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AuditEventPersistenceListener [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>AuditEventPersistenceListener</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">@TransactionalEventListener(BEFORE_COMMIT)<BR ALIGN="LEFT"/>inserts the audit row in the caller's transaction<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  InAppChannel -> NotificationChannel [arrowhead=empty, style=dashed, color="#333333"];
  SimulatedEmailChannel -> NotificationChannel [arrowhead=empty, style=dashed, color="#333333"];
  SimulatedSmsChannel -> NotificationChannel [arrowhead=empty, style=dashed, color="#333333"];
  NotificationMonitor -> NotificationChannel [arrowhead=none, arrowtail=odiamond, dir=back, color="#333333", label="0..*"];
  NotificationMonitor -> Notification [arrowhead=vee, style=dashed, color="#666666", label="creates"];
  AuditPublisher -> AuditableEvent [arrowhead=vee, style=dashed, color="#666666", label="publishes"];
  AuditEventPersistenceListener -> AuditableEvent [arrowhead=vee, style=dashed, color="#666666", label="observes"];
}

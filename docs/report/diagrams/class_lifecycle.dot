digraph G {
  graph [rankdir=BT, fontname="Helvetica", nodesep=0.45, ranksep=0.65, splines=true, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  IncidentState [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6" ALIGN="CENTER"><I>&laquo;enumeration&raquo;</I><BR/><B>IncidentState</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">NEW, CLASSIFIED, ASSIGNED, ACKNOWLEDGED,<BR ALIGN="LEFT"/>IN_PROGRESS, PENDING_INFO, RESOLVED,<BR ALIGN="LEFT"/>VERIFIED, CLOSED<BR ALIGN="LEFT"/>-countsTowardWorkload: Boolean<BR ALIGN="LEFT"/>-terminal: Boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+fromName(name): IncidentState<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IncidentTransition [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6" ALIGN="CENTER"><I>&laquo;enumeration&raquo;</I><BR/><B>IncidentTransition</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">CLASSIFY, ASSIGN, REASSIGN, ACKNOWLEDGE, START_WORK,<BR ALIGN="LEFT"/>REQUEST_INFO, PROVIDE_INFO, RESOLVE, VERIFY,<BR ALIGN="LEFT"/>REOPEN, CLOSE<BR ALIGN="LEFT"/>-from: Set&lt;IncidentState&gt;<BR ALIGN="LEFT"/>-to: IncidentState<BR ALIGN="LEFT"/>-permission: Permission<BR ALIGN="LEFT"/>-auditAction: String<BR ALIGN="LEFT"/>-requiresReason: Boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+allowsFrom(state): Boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IncidentStateMachine [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><I>&laquo;object&raquo;</I><BR/><B>IncidentStateMachine</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+transitionsFrom(state): List&lt;IncidentTransition&gt;<BR ALIGN="LEFT"/>+availableTo(state, user): List&lt;IncidentTransition&gt;<BR ALIGN="LEFT"/>+canApply(transition, state): Boolean<BR ALIGN="LEFT"/>+apply(record, transition, reason, user): Result<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IncidentRecord [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>IncidentRecord</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-id: String<BR ALIGN="LEFT"/>-state: IncidentState<BR ALIGN="LEFT"/>-reporterId: Long<BR ALIGN="LEFT"/>-assigneeId: Long?<BR ALIGN="LEFT"/>-categoryId: Long?<BR ALIGN="LEFT"/>-serviceId: Long?<BR ALIGN="LEFT"/>-priority: Priority?<BR ALIGN="LEFT"/>-assignedAt / firstResponseAt / resolvedAt / closedAt: Instant?<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+copy(...): IncidentRecord  (immutable)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IncidentStore [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e6f0ff" ALIGN="CENTER"><I>&laquo;interface&raquo;</I><BR/><B>IncidentStore</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+find(id): IncidentRecord?<BR ALIGN="LEFT"/>+lock(id): IncidentRecord?<BR ALIGN="LEFT"/>+save(record)<BR ALIGN="LEFT"/>+activeCounts(ids): Map&lt;Long, Int&gt;<BR ALIGN="LEFT"/>+lockTechnician(id)<BR ALIGN="LEFT"/>+list(query): IncidentPage<BR ALIGN="LEFT"/>+similarResolved(...): List&lt;ResolvedIncident&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  JpaIncidentStore [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>JpaIncidentStore</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-em: EntityManager<BR ALIGN="LEFT"/>-jdbc: JdbcTemplate<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(implements IncidentStore)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IncidentLifecycleService [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>IncidentLifecycleService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-store: IncidentStore<BR ALIGN="LEFT"/>-log: InvestigationLog<BR ALIGN="LEFT"/>-feedbacks: FeedbackStore<BR ALIGN="LEFT"/>-audit: AuditPublisher<BR ALIGN="LEFT"/>-events: ApplicationEventPublisher<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+get(id, user)<BR ALIGN="LEFT"/>+list(...)<BR ALIGN="LEFT"/>+transition(id, transition, reason, user)<BR ALIGN="LEFT"/>+addNote(...)<BR ALIGN="LEFT"/>+timeline(id, user)<BR ALIGN="LEFT"/>+submitFeedback(id, rating, comment, user)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Permission [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6" ALIGN="CENTER"><I>&laquo;enumeration&raquo;</I><BR/><B>Permission</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">INCIDENT_CREATE, INCIDENT_VIEW_OWN, INCIDENT_VIEW_ASSIGNED,<BR ALIGN="LEFT"/>INCIDENT_VIEW_ALL, INCIDENT_ASSIGN, INCIDENT_WORK,<BR ALIGN="LEFT"/>INCIDENT_VERIFY_OWN, INCIDENT_CLOSE, USER_MANAGE, CATALOG_MANAGE,<BR ALIGN="LEFT"/>SLA_CONFIGURE, ASSIGNMENT_CONFIGURE, AUDIT_VIEW, ANALYTICS_VIEW<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  Role [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6" ALIGN="CENTER"><I>&laquo;enumeration&raquo;</I><BR/><B>Role</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">EMPLOYEE<BR ALIGN="LEFT"/>TECHNICIAN<BR ALIGN="LEFT"/>ADMIN<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+authority: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RolePermissions [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><I>&laquo;object&raquo;</I><BR/><B>RolePermissions</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-grants: Map&lt;Role, Set&lt;Permission&gt;&gt;  (EnumMap, unmodifiable)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+of(role): Set&lt;Permission&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  InvestigationPolicy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><I>&laquo;object&raquo;</I><BR/><B>InvestigationPolicy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+newManualEntry(...)<BR ALIGN="LEFT"/>+entryFor(incidentId, result, author, now)<BR ALIGN="LEFT"/>+canSee(user, entry): Boolean<BR ALIGN="LEFT"/>+visibleTo(user, entries)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  FeedbackPolicy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><I>&laquo;object&raquo;</I><BR/><B>FeedbackPolicy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+submit(...): Feedback  (once, reporter only, rating 1..5)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  IncidentTransition -> IncidentState [arrowhead=vee, color="#333333", label="from / to"];
  IncidentTransition -> Permission [arrowhead=vee, color="#333333", label="requires"];
  IncidentStateMachine -> IncidentTransition [arrowhead=vee, style=dashed, color="#666666", label="reads table"];
  IncidentRecord -> IncidentState [arrowhead=vee, color="#333333", label="state"];
  JpaIncidentStore -> IncidentStore [arrowhead=empty, style=dashed, color="#333333"];
  IncidentLifecycleService -> IncidentStore [arrowhead=none, arrowtail=odiamond, dir=back, color="#333333"];
  IncidentLifecycleService -> IncidentStateMachine [arrowhead=vee, style=dashed, color="#666666"];
  IncidentLifecycleService -> InvestigationPolicy [arrowhead=vee, style=dashed, color="#666666"];
  IncidentLifecycleService -> FeedbackPolicy [arrowhead=vee, style=dashed, color="#666666"];
  RolePermissions -> Role [arrowhead=vee, color="#333333", label="keys"];
  RolePermissions -> Permission [arrowhead=none, arrowtail=odiamond, dir=back, color="#333333", label="values"];
}

digraph G {
  graph [rankdir=BT, fontname="Helvetica", nodesep=0.18, ranksep=0.5, splines=true, pad=0.2];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  AssignmentStrategy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#e6f0ff" ALIGN="CENTER"><I>&laquo;interface&raquo;</I><BR/><B>AssignmentStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+key: String<BR ALIGN="LEFT"/>+autoAssigns: Boolean<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+rank(candidates, request, defaultMaxWorkload): List&lt;Candidate&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LoadBasedStrategy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>LoadBasedStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+rank(...)  lowest active/max first<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  SkillBasedStrategy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>SkillBasedStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+rank(...)  highest proficiency; drops the unskilled<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  RoundRobinStrategy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>RoundRobinStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+rank(...)  longest since last assignment<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ManualStrategy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>ManualStrategy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+rank(...)  autoAssigns = false<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AssignmentEngine [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>AssignmentEngine</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-byKey: Map&lt;String, AssignmentStrategy&gt;<BR ALIGN="LEFT"/>-recommender: TechnicianRecommender<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+decide(settings, request, candidates): AssignmentDecision<BR ALIGN="LEFT"/>+registeredKeys(): Set&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  TechnicianRecommender [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>TechnicianRecommender</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+weightsFor(priority): Weights<BR ALIGN="LEFT"/>+recommend(candidates, request, defaultMax, limit): List&lt;Recommendation&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EligibilityPolicy [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><I>&laquo;object&raquo;</I><BR/><B>EligibilityPolicy</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+effectiveMax(c, default): Int<BR ALIGN="LEFT"/>+hasCapacity(c, default): Boolean<BR ALIGN="LEFT"/>+eligible(...): List&lt;Candidate&gt;<BR ALIGN="LEFT"/>+requireCanTake(c, default)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Candidate [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>Candidate</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+technician: TechnicianSummary<BR ALIGN="LEFT"/>+activeCount: Int<BR ALIGN="LEFT"/>+lastAssignedAt: Instant?<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">require(activeCount &gt;= 0)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  AssignmentRequest [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>AssignmentRequest</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+categoryId: Long?<BR ALIGN="LEFT"/>+priority: Priority<BR ALIGN="LEFT"/>+excludeTechnicianIds: Set&lt;Long&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  AssignmentDecision [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>AssignmentDecision</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+outcome: AssignmentOutcome<BR ALIGN="LEFT"/>+strategyKey: String<BR ALIGN="LEFT"/>+chosen: TechnicianSummary?<BR ALIGN="LEFT"/>+recommendations: List&lt;Recommendation&gt;<BR ALIGN="LEFT"/>+fellBackFrom: String?<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  AssignmentOutcome [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#fff4d6" ALIGN="CENTER"><I>&laquo;enumeration&raquo;</I><BR/><B>AssignmentOutcome</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">ASSIGNED<BR ALIGN="LEFT"/>MANUAL_REQUIRED<BR ALIGN="LEFT"/>NO_ELIGIBLE_<BR ALIGN="LEFT"/>TECHNICIAN<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR></TABLE>>];
  IncidentAssignmentService [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#ffffff" ALIGN="CENTER"><B>IncidentAssignmentService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">-engine: AssignmentEngine<BR ALIGN="LEFT"/>-store: IncidentStore<BR ALIGN="LEFT"/>-directory: UserDirectory (SPI)<BR ALIGN="LEFT"/>-settings: AssignmentSettingsProvider (SPI)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+assignAutomatically(id, reason, user)<BR ALIGN="LEFT"/>+assignTo(id, technicianId, reason, user)<BR ALIGN="LEFT"/>+recommendations(id, user)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  LoadBasedStrategy -> AssignmentStrategy [arrowhead=empty, style=dashed, color="#333333"];
  SkillBasedStrategy -> AssignmentStrategy [arrowhead=empty, style=dashed, color="#333333"];
  RoundRobinStrategy -> AssignmentStrategy [arrowhead=empty, style=dashed, color="#333333"];
  ManualStrategy -> AssignmentStrategy [arrowhead=empty, style=dashed, color="#333333"];
  AssignmentEngine -> AssignmentStrategy [arrowhead=none, arrowtail=odiamond, dir=back, color="#333333", label="1..*"];
  AssignmentEngine -> TechnicianRecommender [arrowhead=none, arrowtail=diamond, dir=back, color="#333333"];
  AssignmentEngine -> EligibilityPolicy [arrowhead=vee, style=dashed, color="#666666"];
  AssignmentEngine -> AssignmentDecision [arrowhead=vee, style=dashed, color="#666666", label="returns"];
  AssignmentDecision -> AssignmentOutcome [arrowhead=vee, color="#333333"];
  AssignmentEngine -> Candidate [arrowhead=vee, style=dashed, color="#666666"];
  AssignmentEngine -> AssignmentRequest [arrowhead=vee, style=dashed, color="#666666"];
  IncidentAssignmentService -> AssignmentEngine [arrowhead=none, arrowtail=odiamond, dir=back, color="#333333"];
}
